[Unit]
Description=Pomodoro Work Time Watcher
After=graphical-session.target

[Service]
EnvironmentFile=-%h/.config/pomowatcher/client.env
ExecStart=/usr/bin/python3 %h/.local/bin/pomowatcher.py
Restart=on-failure
RestartSec=10
PassEnvironment=DISPLAY WAYLAND_DISPLAY XDG_RUNTIME_DIR DBUS_SESSION_BUS_ADDRESS XDG_SESSION_TYPE

[Install]
WantedBy=default.target
